{
    "swagger": "2.0",
    "info": {
        "description": "文档、标签和文件上传服务。",
        "title": "iWiki 接口",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/health": {
            "get": {
                "tags": [
                    "探针"
                ],
                "summary": "检查进程存活",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    }
                }
            }
        },
        "/ready": {
            "get": {
                "tags": [
                    "探针"
                ],
                "summary": "检查服务就绪",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    }
                }
            }
        },
        "/v1/auth/logout": {
            "post": {
                "tags": [
                    "登录"
                ],
                "summary": "退出登录",
                "parameters": [
                    {
                        "type": "string",
                        "default": "1",
                        "description": "来源保护标记，固定为 1",
                        "name": "X-CSRF-Protection",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    }
                }
            }
        },
        "/v1/auth/oidc/callback": {
            "get": {
                "tags": [
                    "登录"
                ],
                "summary": "接收 OIDC 回调",
                "parameters": [
                    {
                        "type": "string",
                        "description": "授权码，与 error 二选一",
                        "name": "code",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "一次性登录状态",
                        "name": "state",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "身份提供方错误代码",
                        "name": "error",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "302": {
                        "description": "登录成功并返回访问页面"
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    }
                }
            }
        },
        "/v1/auth/oidc/login": {
            "get": {
                "description": "跳转至登录页面，登录后返回指定页面。",
                "tags": [
                    "登录"
                ],
                "summary": "发起 OIDC 登录",
                "parameters": [
                    {
                        "type": "string",
                        "default": "/",
                        "description": "登录后的站内路径",
                        "name": "return_to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "302": {
                        "description": "跳转至身份提供方"
                    },
                    "429": {
                        "description": "Too Many Requests",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    }
                }
            }
        },
        "/v1/cos/temp-secret": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "上传"
                ],
                "summary": "获取 COS 临时上传凭据",
                "parameters": [
                    {
                        "description": "文件信息",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/cosModels.Request"
                        }
                    },
                    {
                        "type": "string",
                        "default": "1",
                        "description": "来源保护标记，固定为 1",
                        "name": "X-CSRF-Protection",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/cosModels.CredentialEnvelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    }
                }
            }
        },
        "/v1/docs": {
            "get": {
                "description": "标签取并集；同一字段须包含全部关键词，多个搜索字段取并集。",
                "tags": [
                    "文档"
                ],
                "summary": "查询文档列表",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "页码，从 1 开始",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "每页条数，默认 10、最大 100",
                        "name": "size",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "标签名称",
                        "name": "tags",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "关键词",
                        "name": "keywords",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/docModels.PageEnvelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "文档"
                ],
                "summary": "创建文档",
                "parameters": [
                    {
                        "description": "文档资料",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/docModels.EditRequest"
                        }
                    },
                    {
                        "type": "string",
                        "default": "1",
                        "description": "来源保护标记，固定为 1",
                        "name": "X-CSRF-Protection",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/docModels.IDEnvelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    },
                    "413": {
                        "description": "Request Entity Too Large",
                        "schema": {
                            "$ref": "#/definitions/response.EmptyEnvelope"
                        }
                    }
                }
            }
        },
