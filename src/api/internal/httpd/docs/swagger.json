    "definitions": {
        "cosModels.Credential": {
            "type": "object",
            "properties": {
                "cdn_sign": {
                    "description": "CDN 短时签名，可空。",
                    "type": "string"
                },
                "cdn_sign_param": {
                    "description": "CDN 签名参数名称。",
                    "type": "string"
                },
                "cos_bucket": {
                    "description": "存储桶名称。",
                    "type": "string"
                },
                "cos_region": {
                    "description": "存储地域。",
                    "type": "string"
                },
                "cos_url": {
                    "description": "COS 或 CDN 资源地址。",
                    "type": "string"
                },
                "expired_time": {
                    "description": "临时凭据失效时间，Unix 秒。",
                    "type": "integer"
                },
                "key": {
                    "description": "上传对象路径。",
                    "type": "string"
                },
                "max_file_bytes": {
                    "description": "文件大小上限，单位为字节。",
                    "type": "integer"
                },
                "secret_id": {
                    "description": "临时访问密钥编号。",
                    "type": "string"
                },
                "secret_key": {
                    "description": "临时访问密钥。",
                    "type": "string"
                },
                "start_time": {
                    "description": "临时凭据开始时间，Unix 秒。",
                    "type": "integer"
                },
                "token": {
                    "description": "临时安全令牌。",
                    "type": "string"
                }
            }
        },
        "cosModels.CredentialEnvelope": {
            "type": "object",
            "properties": {
                "data": {
                    "description": "业务数据。",
                    "allOf": [
                        {
                            "$ref": "#/definitions/cosModels.Credential"
                        }
                    ]
                },
                "error_msg": {
                    "description": "错误提示。",
                    "type": "string",
                    "example": ""
                },
                "trace": {
                    "description": "请求追踪编号。",
                    "type": "string",
                    "example": "4bf92f3577b34da6a3ce929d0e0e4736"
                }
            }
        },
        "cosModels.Request": {
            "type": "object",
            "properties": {
                "filename": {
                    "description": "文件名，不含路径。",
                    "type": "string",
                    "example": "示例图片.png"
                }
            }
        },
        "docModels.Detail": {
            "type": "object",
            "properties": {
                "comments": {
                    "description": "评论数量。",
                    "type": "integer"
                },
                "content": {
                    "description": "Markdown 正文。",
                    "type": "string"
                },
                "created_at": {
                    "description": "创建时间，UTC。",
                    "type": "string"
                },
                "header_img": {
                    "description": "封面地址，可空。",
                    "type": "string"
                },
                "id": {
                    "description": "编号。",
                    "type": "string"
                },
                "is_public": {
                    "description": "是否允许其他已登录用户读取。",
                    "type": "boolean"
                },
                "owner": {
                    "description": "作者用户名。",
                    "type": "string",
                    "example": "zhangsan"
                },
                "owner_nick_name": {
                    "description": "作者昵称。",
                    "type": "string",
                    "example": "张三"
                },
                "pv": {
                    "description": "阅读量。",
                    "type": "integer"
                },
                "tags": {
                    "description": "标签名称集合。",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "title": {
                    "description": "文档标题，最多 32 个字符。",
                    "type": "string",
                    "example": "Go 学习笔记"
                },
                "updated_at": {
                    "description": "更新时间，UTC。",
                    "type": "string"
                }
            }
        },
        "docModels.DetailEnvelope": {
